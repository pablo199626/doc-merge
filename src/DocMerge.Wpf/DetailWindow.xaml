<Window x:Class="DocMerge.Wpf.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" Height="520" MinWidth="480" MinHeight="340"
        Icon="Resources/Brand/Talos.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource DialogWindow}"
        Loaded="DetailWindow_Loaded"
        PreviewKeyDown="DetailWindow_PreviewKeyDown">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource Heading}" />
        <TextBox x:Name="DetailText" Grid.Row="1" Text="{Binding DialogBody, Mode=OneWay}" Margin="0,16"
                 Style="{StaticResource ReadOnlyDetailTextBox}" />
        <Button x:Name="CloseButton" Grid.Row="2" Content="Cerrar" HorizontalAlignment="Right"
                IsCancel="True" MinWidth="100" />
    </Grid>
</Window>
