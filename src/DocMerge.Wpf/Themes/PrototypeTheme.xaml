<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:DocMerge.Wpf.Converters"
                    xmlns:models="clr-namespace:DocMerge.Wpf.Models">
    <SolidColorBrush x:Key="CardBrush" Color="#0D808080" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#18808080" />
    <SolidColorBrush x:Key="BorderBrush" Color="#40808080" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF2B78E4" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#282B78E4" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF168553" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#28168553" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFD94B45" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#32D94B45" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFD19A2A" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#32D19A2A" />

    <BooleanToVisibilityConverter x:Key="BooleanVisibilityConverter" />
    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    <converters:InverseBooleanVisibilityConverter x:Key="InverseBooleanVisibilityConverter" />

    <DataTemplate x:Key="RecordTemplate" DataType="{x:Type models:ReviewRecord}">
        <StackPanel Margin="4,0,10,0" VerticalAlignment="Center">
            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Group}" />
                <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Notes}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="InspectorRecordTemplate" DataType="{x:Type models:ReviewRecord}">
        <StackPanel>
            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Group, StringFormat=Grupo: {0}}" />
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Notes, StringFormat=Información: {0}}" TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="MinWidth" Value="42" />
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="ReviewListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style x:Key="ReviewListItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="58" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Padding="0"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ActionKind}" Value="{x:Static models:ReviewActionKind.Replace}">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActionKind}" Value="{x:Static models:ReviewActionKind.Add}">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActionKind}" Value="{x:Static models:ReviewActionKind.Delete}">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActionKind}" Value="{x:Static models:ReviewActionKind.Conflict}">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource CardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="0,0,0,3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
