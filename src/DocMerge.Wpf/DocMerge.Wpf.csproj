<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DocMerge.Desktop</AssemblyName>
    <RootNamespace>DocMerge.Wpf</RootNamespace>
    <!-- WPF0001 guards the native Fluent ThemeMode API required for live light/dark switching. -->
    <NoWarn>$(NoWarn);CS1591;WPF0001</NoWarn>
  </PropertyGroup>

</Project>
