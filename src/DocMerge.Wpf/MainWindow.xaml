<Window x:Class="DocMerge.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DocMerge — Prototipo de revisión"
        Width="1440"
        Height="900"
        MinWidth="920"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="F7" Command="{Binding NextIssueCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="DocMerge" />
                        <Border Margin="12,0,0,0" Padding="8,3" Background="{StaticResource WarningSoftBrush}" CornerRadius="10">
                            <TextBlock Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold" Text="PROTOTIPO · NO GUARDA ARCHIVOS" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Revisa cada propuesta antes de generar el documento final" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Tema" />
                    <ComboBox Width="116" Margin="0,0,12,0" SelectedIndex="0" SelectionChanged="Theme_SelectionChanged" AutomationProperties.Name="Tema de la aplicación">
                        <ComboBoxItem Tag="System" Content="Sistema" />
                        <ComboBoxItem Tag="Light" Content="Claro" />
                        <ComboBoxItem Tag="Dark" Content="Oscuro" />
                    </ComboBox>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding UndoCommand}" ToolTip="Deshacer (Ctrl+Z)" AutomationProperties.Name="Deshacer">↶</Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RedoCommand}" ToolTip="Rehacer (Ctrl+Y)" AutomationProperties.Name="Rehacer">↷</Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,14,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="DOCUMENTO DE ORIGEN" />
                    <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="alumnado_origen.docx" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="DOCUMENTO DE DESTINO" />
                    <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="alumnado_destino.docx" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="LISTADO PDF" />
                    <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="listado_alumnado.pdf" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="24,14,24,10" Padding="10" Background="{StaticResource CardBrush}" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource PillButtonStyle}" Command="{Binding RestoreSafeProposalCommand}" Content="Restaurar propuesta segura" />
                <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PillButtonStyle}" Command="{Binding NextIssueCommand}" Content="Siguiente incidencia" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ReviewSummary}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="24,0,24,0">
            <Grid x:Name="WideLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="10,8">
                    <Grid Margin="24,0,178,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="Origen" />
                        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />
                        <TextBlock Grid.Column="2" Margin="12,0" FontWeight="SemiBold" Text="Resultado propuesto" />
                        <Border Grid.Column="3" Background="{StaticResource BorderBrush}" />
                        <TextBlock Grid.Column="4" Margin="12,0" FontWeight="SemiBold" Text="Destino original" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" ClipToBounds="True">
                    <ListBox
                             ItemsSource="{Binding Rows}"
                             SelectedItem="{Binding SelectedRow}"
                             Style="{StaticResource ReviewListStyle}"
                             ItemContainerStyle="{StaticResource ReviewListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid MinHeight="57">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="{Binding Marker}" />
                                        <ContentControl Grid.Column="1" Margin="4,7" Content="{Binding Source}" ContentTemplate="{StaticResource RecordTemplate}" />
                                        <Border Grid.Column="2" Background="{StaticResource BorderBrush}" />
                                        <ContentControl Grid.Column="3" Margin="8,7" Content="{Binding Result}" ContentTemplate="{StaticResource RecordTemplate}" />
                                        <Border Grid.Column="4" Background="{StaticResource BorderBrush}" />
                                        <ContentControl Grid.Column="5" Margin="8,7" Content="{Binding Destination}" ContentTemplate="{StaticResource RecordTemplate}" />
                                        <Button Grid.Column="6" Margin="6,0,8,0" Padding="8,5" VerticalAlignment="Center"
                                                Command="{Binding DataContext.ChangeDecisionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding ActionLabel}" />
                                    </Grid>
                                    <Border Padding="12,8" Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="0,1,0,0"
                                            Visibility="{Binding IsConflict, Converter={StaticResource BooleanVisibilityConverter}}">
                                        <DockPanel>
                                            <TextBlock Margin="0,0,10,0" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" Text="⚠" />
                                            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Explanation}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Border Grid.Row="2" Margin="0,8,0,0" Padding="12" Background="{StaticResource CardBrush}" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedRow.StatusText}" />
                        <TextBlock Grid.Column="1" Margin="16,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SelectedRow.Explanation}" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Padding="12,5" Command="{Binding ChangeDecisionCommand}" CommandParameter="{Binding SelectedRow}" Content="{Binding SelectedRow.ActionLabel}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="CompactLayout" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="12,0,110,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Resultado propuesto" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Comparar con" />
                        <RadioButton Margin="12,0,0,0" IsChecked="{Binding CompareWithSource}" Content="Origen" GroupName="Comparison" />
                        <RadioButton Margin="12,0,0,0" IsChecked="{Binding CompareWithSource, Converter={StaticResource InverseBooleanConverter}}" Content="Destino" GroupName="Comparison" />
                    </StackPanel>
                </Grid>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow}"
                         Style="{StaticResource ReviewListStyle}"
                         ItemContainerStyle="{StaticResource ReviewListItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="{Binding Marker}" />
                                <ContentControl Grid.Column="1" Content="{Binding Result}" ContentTemplate="{StaticResource RecordTemplate}" />
                                <Grid Grid.Column="2">
                                    <ContentControl Content="{Binding Source}" ContentTemplate="{StaticResource RecordTemplate}" Visibility="{Binding DataContext.CompareWithSource, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <ContentControl Content="{Binding Destination}" ContentTemplate="{StaticResource RecordTemplate}" Visibility="{Binding DataContext.CompareWithSource, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseBooleanVisibilityConverter}}" />
                                </Grid>
                                <Button Grid.Column="3" Margin="6,0,0,0" Padding="8,5" VerticalAlignment="Center"
                                        Command="{Binding DataContext.ChangeDecisionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding ActionLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource CardBorderStyle}" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedRow.StatusText}" />
                        <TextBlock Grid.Column="1" Margin="16,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SelectedRow.Explanation}" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Padding="12,5" Command="{Binding ChangeDecisionCommand}" CommandParameter="{Binding SelectedRow}" Content="{Binding SelectedRow.ActionLabel}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="4" Margin="24,10,24,20" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Demostración con datos ficticios. No se ha leído ni modificado ningún documento." />
                <Button Grid.Column="1" Style="{StaticResource PillButtonStyle}" IsEnabled="False" Content="Guardar resultado…" ToolTip="Disponible cuando se conecte el núcleo en una fase posterior" />
            </Grid>
        </Border>
    </Grid>

</Window>
