<Window x:Class="DocMerge.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:DocMerge.Wpf.ViewModels"
        Title="DocMerge — Generación de clases"
        Width="1280" Height="820" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <DataTemplate x:Key="InputCardTemplate" DataType="{x:Type vm:InputSelectionViewModel}">
            <Border Style="{StaticResource Card}"
                    Margin="6" MinWidth="260"
                    AllowDrop="True"
                    DragEnter="InputCard_DragEnter"
                    Drop="InputCard_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="12"
                                Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="{Binding Icon}" FontSize="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                                       FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,15,0,12" Padding="12" MinHeight="105"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Arrastra aquí o usa Examinar" HorizontalAlignment="Center"
                                       Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding Path}" Margin="0,8,0,0" TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                            <TextBlock Text="{Binding Status}" Margin="0,6,0,0" TextAlignment="Center"
                                       Foreground="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="{Binding Error}" Margin="0,6,0,0" TextAlignment="Center"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       Visibility="{Binding HasError, Converter={StaticResource BooleanVisibility}}" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Examinar…" Command="{Binding DataContext.BrowseInputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="1" Content="Quitar" Margin="8,0,0,0"
                                Command="{Binding DataContext.RemoveInputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CompactInputCardTemplate" DataType="{x:Type vm:InputSelectionViewModel}">
            <Border Style="{StaticResource Card}" Margin="6" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="{Binding Icon}" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding Path}" Style="{StaticResource MutedText}"
                                   FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Path}" />
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="▤" Foreground="White" FontSize="23"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="DocMerge" FontSize="21" FontWeight="Bold" />
                        <TextBlock Text="Generación de clases" FontSize="11" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Row="1" Margin="0,34,0,0" Padding="12" CornerRadius="8"
                        Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="⌂  Generación de clases" Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold" />
                </Border>
                <StackPanel Grid.Row="3">
                    <CheckBox Content="Modo oscuro" IsChecked="{Binding IsDark}" Margin="2,0,0,18" />
                    <TextBlock Text="{Binding Version, StringFormat=DocMerge v{0}}" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="26,18,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="15,0,15,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="17">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="1"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="2"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StepOneIndicator}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Seleccionar archivos" Margin="9,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="17">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="2"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StepTwoIndicator}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Revisar información" Margin="9,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="17">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Generar documentos" Margin="9,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid Visibility="{Binding IsSelectionStep, Converter={StaticResource BooleanVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="6,0,6,15">
                        <TextBlock Text="Selecciona los archivos de entrada" Style="{StaticResource Heading}" />
                        <TextBlock Text="Los históricos son la base global; los PDF determinan la pertenencia a cada clase."
                                   Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260" />
                                <ColumnDefinition Width="*" MinWidth="260" />
                                <ColumnDefinition Width="*" MinWidth="260" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Content="{Binding HistoricalInput}" ContentTemplate="{StaticResource InputCardTemplate}" />
                            <ContentControl Grid.Column="1" Content="{Binding RosterInput}" ContentTemplate="{StaticResource InputCardTemplate}" />
                            <ContentControl Grid.Column="2" Content="{Binding TemplateInput}" ContentTemplate="{StaticResource InputCardTemplate}" />
                        </Grid>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="6,14,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding GeneralError}" Foreground="{DynamicResource ErrorBrush}"
                                       Visibility="{Binding HasGeneralError, Converter={StaticResource BooleanVisibility}}" />
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Cancelar" Margin="8,0"
                                Command="{Binding CancelCommand}" />
                        <ui:Button Grid.Column="2" Content="Analizar y continuar" Appearance="Primary"
                                   Command="{Binding AnalyzeCommand}" />
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsReviewStep, Converter={StaticResource BooleanVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{Binding HistoricalInput}" ContentTemplate="{StaticResource CompactInputCardTemplate}" />
                        <ContentControl Grid.Column="1" Content="{Binding RosterInput}" ContentTemplate="{StaticResource CompactInputCardTemplate}" />
                        <ContentControl Grid.Column="2" Content="{Binding TemplateInput}" ContentTemplate="{StaticResource CompactInputCardTemplate}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Clases detectadas" Style="{StaticResource SectionHeading}" />
                                    <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="12" Padding="9,3">
                                        <TextBlock Text="{Binding Classes.Count}" Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <ListBox Grid.Row="1" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}"
                                         BorderThickness="0" Background="Transparent" Margin="0,12">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder" Padding="12" CornerRadius="10"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="9"
                                                        Background="{DynamicResource AccentSoftBrush}">
                                                    <TextBlock Text="▤" Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Code}" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding StudentCount, StringFormat={}{0} alumnos}" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="10" Padding="8,2">
                                                        <TextBlock Text="{Binding WarningCount, StringFormat=⚠ {0}}"
                                                                   Foreground="{DynamicResource WarningBrush}" FontSize="11" />
                                                    </Border>
                                                    <TextBlock Text="{Binding BlockingCount, StringFormat=Bloqueos: {0}}"
                                                               Foreground="{DynamicResource ErrorBrush}" FontSize="10"
                                                               HorizontalAlignment="Right" Margin="0,4,0,0"
                                                               Visibility="{Binding HasBlockingIssues, Converter={StaticResource BooleanVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10">
                                    <TextBlock Text="{Binding BatchSummary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedClass.Code, StringFormat=Alumnos de {0}}" Style="{StaticResource SectionHeading}" />
                                    <Border Grid.Column="1" Background="{DynamicResource SuccessSoftBrush}" CornerRadius="12" Padding="10,4" Margin="6,0">
                                        <TextBlock Text="{Binding SelectedClass.RecoveredCount, StringFormat=✓ {0} recuperados}"
                                                   Foreground="{DynamicResource SuccessBrush}" FontSize="11" />
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource WarningSoftBrush}" CornerRadius="12" Padding="10,4" Margin="6,0">
                                        <TextBlock Text="{Binding SelectedClass.MissingCount, StringFormat=⚠ {0} sin histórico}"
                                                   Foreground="{DynamicResource WarningBrush}" FontSize="11" />
                                    </Border>
                                    <Border Grid.Column="3" Background="{DynamicResource ErrorSoftBrush}" CornerRadius="12" Padding="10,4" Margin="6,0">
                                        <TextBlock Text="{Binding SelectedClass.UnresolvedCount, StringFormat=! {0} conflictos}"
                                                   Foreground="{DynamicResource ErrorBrush}" FontSize="11" />
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,14,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="Buscar alumno o NIA…" />
                                    <ComboBox Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding StatusFilters}"
                                              SelectedItem="{Binding SelectedFilter}" />
                                </Grid>
                                <DataGrid Grid.Row="2" ItemsSource="{Binding VisibleStudents}" AutoGenerateColumns="False"
                                          MinWidth="0" HorizontalAlignment="Stretch">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Ordinal}" Width="48" />
                                        <DataGridTextColumn Header="Nombre y apellidos" Binding="{Binding Name}" Width="2.2*" MinWidth="240" />
                                        <DataGridTextColumn Header="NIA" Binding="{Binding StudentNumber}" Width="110" />
                                        <DataGridTemplateColumn Header="Estado" Width="1.5*" MinWidth="190">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="StatusBadge" HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource SuccessSoftBrush}" CornerRadius="12" Padding="9,4">
                                                        <TextBlock x:Name="StatusText" Text="{Binding Status}"
                                                                   Foreground="{DynamicResource SuccessBrush}" FontSize="11" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Recuperado · históricos equivalentes">
                                                            <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Sin histórico">
                                                            <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Conflicto histórico">
                                                            <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Identidad ambigua">
                                                            <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Procedencia" Binding="{Binding Source}" Width="*" MinWidth="150" />
                                        <DataGridTemplateColumn Header="Detalle" Width="115">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Ver detalle" Padding="10,4"
                                                            Command="{Binding DataContext.ShowStudentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="3" Text="{Binding VisibleStudentSummary}" Margin="0,8,0,0"
                                           Style="{StaticResource MutedText}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="6,12,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Volver a archivos" Command="{Binding BackToFilesCommand}" />
                        <Button Grid.Column="2" Content="Ver incidencias del lote" Margin="8,0"
                                Command="{Binding ShowAllIssuesCommand}" />
                        <ui:Button Grid.Column="3" Content="Continuar a generación" Appearance="Primary"
                                   Command="{Binding ContinueToGenerationCommand}" />
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsGenerationStep, Converter={StaticResource BooleanVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="6,0,6,15">
                        <TextBlock Text="Generar documentos" Style="{StaticResource Heading}" />
                        <TextBlock Text="Elige el nombre y la ubicación de una carpeta nueva. Se ejecutará exactamente el plan revisado."
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="850" HorizontalAlignment="Center">
                            <Border Style="{StaticResource Card}" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="Carpeta nueva de salida" Style="{StaticResource SectionHeading}" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding OutputParent, Mode=OneWay}" IsReadOnly="True" ToolTip="Carpeta contenedora" />
                                        <Button Grid.Column="1" Content="Elegir ubicación…" Margin="10,0,0,0"
                                                Command="{Binding BrowseOutputCommand}" />
                                    </Grid>
                                    <TextBlock Text="Nombre de la carpeta nueva" Margin="0,14,0,5" />
                                    <TextBox Text="{Binding OutputFolderName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding OutputDirectory}" Margin="0,10,0,0" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding OutputError}" Margin="0,6,0,0" Foreground="{DynamicResource ErrorBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,12,6,6">
                                <StackPanel>
                                    <TextBlock Text="Resumen del lote revisado" Style="{StaticResource SectionHeading}" />
                                    <TextBlock Text="{Binding BatchSummary}" Margin="0,10,0,0" FontWeight="SemiBold" />
                                    <TextBlock Text="Los avisos no bloqueantes se conservarán. Los filtros de revisión no modifican este lote."
                                               Margin="0,7,0,0" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding ProgressText}" Margin="0,14,0,0" />
                                    <TextBlock Text="{Binding FinalStatus}" Margin="0,10,0,0" FontWeight="SemiBold" />
                                    <Button Content="Abrir carpeta de salida" Margin="0,12,0,0" HorizontalAlignment="Left"
                                            Command="{Binding OpenOutputCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="6,12,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Volver a revisión" Command="{Binding BackToReviewCommand}" />
                        <Button Grid.Column="2" Content="Cancelar" Margin="8,0" Command="{Binding CancelCommand}" />
                        <ui:Button Grid.Column="3" Content="Generar documentos" Appearance="Primary"
                                   Command="{Binding GenerateCommand}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
