<Window x:Class="DocMerge.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:domain="clr-namespace:DocMerge.Domain.Generation;assembly=DocMerge.Domain"
        xmlns:services="clr-namespace:DocMerge.Wpf.Services"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:DocMerge.Wpf.ViewModels"
        Title="Talos — Generación de clases"
        Icon="Resources/Brand/Talos.ico"
        Width="1366" Height="820" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded"
        SizeChanged="MainWindow_SizeChanged"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />

        <Style x:Key="SidebarLabel" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <DataTemplate x:Key="CompactInputCardTemplate" DataType="{x:Type vm:InputSelectionViewModel}">
            <Border Style="{StaticResource Card}" Margin="5" Padding="11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="{DynamicResource AccentSoftBrush}">
                        <ui:SymbolIcon x:Name="CompactInputIcon" Symbol="Folder24" FontSize="20"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding DisplayLocation}" Style="{StaticResource MutedText}"
                                   FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding DisplayLocation}" />
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="10" TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:InputKind.Template}">
                    <Setter TargetName="CompactInputIcon" Property="ui:SymbolIcon.Symbol" Value="Document24" />
                    <Setter TargetName="CompactInputIcon" Property="Foreground" Value="{DynamicResource TemplateAccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="InputCardTemplate" DataType="{x:Type vm:InputSelectionViewModel}">
            <Border Style="{StaticResource InputCard}"
                    Margin="6" MinWidth="250"
                    AllowDrop="True"
                    DragEnter="InputCard_DragEnter"
                    DragLeave="InputCard_DragLeave"
                    Drop="InputCard_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}">
                            <ui:SymbolIcon x:Name="InputKindIcon" Symbol="Folder28" FontSize="28"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                                       FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,15,0,12" Padding="14" MinHeight="126"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="9">
                        <Grid>
                            <StackPanel x:Name="EmptyInputPanel" VerticalAlignment="Center">
                                <ui:SymbolIcon x:Name="EmptyInputIcon" Symbol="Folder28" FontSize="32"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Center" />
                                <TextBlock Text="Arrastra aquí la carpeta o el archivo"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           FontWeight="SemiBold" Margin="0,9,0,0" />
                                <TextBlock Text="También puedes seleccionarlo desde el explorador"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>

                            <Grid x:Name="SelectedInputPanel">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:InputSelectionState.Empty}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="InputStateIcon" Symbol="CheckmarkCircle24" FontSize="24"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding DisplayLocation}" Style="{StaticResource MutedText}"
                                               FontSize="11" Margin="0,3,0,0" TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayLocation}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock x:Name="InputStatusText" Text="{Binding Status}"
                                                   Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ProgressBar Width="62" Height="4" Margin="10,0,0,0"
                                                     IsIndeterminate="True"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Error}" Margin="0,6,0,0"
                                               Foreground="{DynamicResource ErrorBrush}" FontSize="11"
                                               Visibility="{Binding HasError, Converter={StaticResource BooleanVisibility}}"
                                               automation:AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding BrowseActionText}"
                                Command="{Binding DataContext.BrowseInputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" MinHeight="40" />
                        <Button Grid.Column="1" Content="Restaurar incluida" Margin="8,0,0,0" MinHeight="40"
                                Command="{Binding DataContext.RestoreIncludedTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding CanRestoreBundled, Converter={StaticResource BooleanVisibility}}" />
                        <Button Grid.Column="2" Content="Quitar" Margin="8,0,0,0" MinHeight="40"
                                Command="{Binding DataContext.RemoveInputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanRemoveSelection, Converter={StaticResource BooleanVisibility}}" />
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:InputKind.Template}">
                    <Setter TargetName="InputKindIcon" Property="ui:SymbolIcon.Symbol" Value="Document28" />
                    <Setter TargetName="InputKindIcon" Property="Foreground" Value="{DynamicResource TemplateAccentBrush}" />
                    <Setter TargetName="EmptyInputIcon" Property="ui:SymbolIcon.Symbol" Value="Document24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:InputSelectionState.Empty}">
                    <Setter TargetName="EmptyInputPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:InputSelectionState.Selected}">
                    <Setter TargetName="EmptyInputPanel" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="InputStateIcon" Property="ui:SymbolIcon.Symbol" Value="Info24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:InputSelectionState.Analyzing}">
                    <Setter TargetName="EmptyInputPanel" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="InputStateIcon" Property="ui:SymbolIcon.Symbol" Value="Search24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:InputSelectionState.Validated}">
                    <Setter TargetName="EmptyInputPanel" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="InputStateIcon" Property="ui:SymbolIcon.Symbol" Value="CheckmarkCircle24" />
                    <Setter TargetName="InputStateIcon" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    <Setter TargetName="InputStatusText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:InputSelectionState.Error}">
                    <Setter TargetName="EmptyInputPanel" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="InputStateIcon" Property="ui:SymbolIcon.Symbol" Value="ErrorCircle24" />
                    <Setter TargetName="InputStateIcon" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                    <Setter TargetName="InputStatusText" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="64" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="1" Panel.ZIndex="8"
                Background="{DynamicResource OverlayBrush}" BorderThickness="0"
                Click="SidebarOverlay_Click"
                Visibility="{Binding IsSidebarOverlayVisible, Converter={StaticResource BooleanVisibility}}"
                automation:AutomationProperties.Name="Cerrar menú lateral" />

        <!--SideBar-->
        <Border x:Name="SidebarBorder" Grid.Column="0" Panel.ZIndex="10" Width="64"
                HorizontalAlignment="Left"
                ClipToBounds="True"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                Padding="8,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Height="48" ToolTip="{Binding Version, StringFormat=Talos v{0}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="42" Height="42" Source="Resources/Brand/talos-64.png"
                           Stretch="Uniform" SnapsToDevicePixels="True"
                           automation:AutomationProperties.Name="Logotipo de Talos" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                Style="{StaticResource SidebarLabel}">
                        <TextBlock Text="TALOS" FontSize="20" FontWeight="SemiBold" TextWrapping="NoWrap" />
                        <TextBlock Text="Automatización documental" FontSize="10" Style="{StaticResource MutedText}"
                                   TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>

                <Button x:Name="SidebarToggleButton" Grid.Row="1" Margin="0,12,0,4" Style="{StaticResource SidebarActionButton}"
                        Click="SidebarToggleButton_Click"
                        ToolTip="Expandir o contraer menú"
                        automation:AutomationProperties.Name="Expandir o contraer menú">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon FontSize="20">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="PanelLeftExpand20" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                            <Setter Property="Symbol" Value="PanelLeftContract20" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <TextBlock Grid.Column="1" Text="Contraer menú" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="NoWrap"
                                   Style="{StaticResource SidebarLabel}" />
                    </Grid>
                </Button>

                <Border Grid.Row="2" Margin="0,10,0,0" MinWidth="44" MinHeight="44" Padding="9,8"
                        Background="{DynamicResource AccentSoftBrush}" CornerRadius="8"
                        TextElement.Foreground="{DynamicResource SidebarActiveForegroundBrush}"
                        ToolTip="Generación de clases"
                        automation:AutomationProperties.Name="Generación de clases, sección activa">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Home20" FontSize="20" />
                        <TextBlock Grid.Column="1" Text="Generación de clases" Margin="8,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="NoWrap"
                                   Style="{StaticResource SidebarLabel}" />
                    </Grid>
                </Border>

                <Button x:Name="ThemeMenuButton" Grid.Row="4" Margin="0,0,0,8"
                        Style="{StaticResource SidebarActionButton}"
                        Click="ThemeMenuButton_Click" ToolTip="{Binding ThemeSummary}"
                        automation:AutomationProperties.Name="{Binding ThemeSummary}">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Sistema" Command="{Binding SetThemeCommand}" IsCheckable="True"
                                      IsChecked="{Binding IsSystemThemeSelected, Mode=OneWay}"
                                      CommandParameter="{x:Static services:ThemePreference.System}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Desktop20" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Claro" Command="{Binding SetThemeCommand}" IsCheckable="True"
                                      IsChecked="{Binding IsLightThemeSelected, Mode=OneWay}"
                                      CommandParameter="{x:Static services:ThemePreference.Light}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="WeatherSunny20" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Oscuro" Command="{Binding SetThemeCommand}" IsCheckable="True"
                                      IsChecked="{Binding IsDarkThemeSelected, Mode=OneWay}"
                                      CommandParameter="{x:Static services:ThemePreference.Dark}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="WeatherMoon20" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon FontSize="20">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Desktop20" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedThemePreference}" Value="{x:Static services:ThemePreference.Light}">
                                            <Setter Property="Symbol" Value="WeatherSunny20" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedThemePreference}" Value="{x:Static services:ThemePreference.Dark}">
                                            <Setter Property="Symbol" Value="WeatherMoon20" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SidebarLabel}">
                            <TextBlock Text="Apariencia" FontWeight="SemiBold" TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding ThemeSummary}" Style="{StaticResource MutedText}"
                                       FontSize="10" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Button>

            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,18,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="14,0,14,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepCircle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepOneState}" Value="{x:Static vm:WorkflowStepState.Current}">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StepOneState}" Value="{x:Static vm:WorkflowStepState.Completed}">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StepOneIndicator}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StepOneState}" Value="{x:Static vm:WorkflowStepState.Current}">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="Seleccionar archivos" Style="{StaticResource StepTitle}" FontWeight="SemiBold" />
                </StackPanel>

                <Border Grid.Column="1" Height="2" Margin="14,17,14,0" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StepOneState}" Value="{x:Static vm:WorkflowStepState.Completed}">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepCircle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepTwoState}" Value="{x:Static vm:WorkflowStepState.Current}">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StepTwoState}" Value="{x:Static vm:WorkflowStepState.Completed}">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StepTwoIndicator}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StepTwoState}" Value="{x:Static vm:WorkflowStepState.Current}">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StepTwoState}" Value="{x:Static vm:WorkflowStepState.Completed}">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="Revisar información" Style="{StaticResource StepTitle}" FontWeight="SemiBold" />
                </StackPanel>

                <Border Grid.Column="3" Height="2" Margin="14,17,14,0" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StepTwoState}" Value="{x:Static vm:WorkflowStepState.Completed}">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel Grid.Column="4">
                    <Border HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepCircle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepThreeState}" Value="{x:Static vm:WorkflowStepState.Current}">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StepThreeState}" Value="{x:Static vm:WorkflowStepState.Completed}">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StepThreeIndicator}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StepThreeState}" Value="{x:Static vm:WorkflowStepState.Current}">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StepThreeState}" Value="{x:Static vm:WorkflowStepState.Completed}">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="Generar documentos" Style="{StaticResource StepTitle}" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid Visibility="{Binding IsSelectionStep, Converter={StaticResource BooleanVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="6,0,6,15">
                        <TextBlock x:Name="SelectionHeading" Text="Selecciona los archivos de entrada"
                                   Style="{StaticResource Heading}" Focusable="True" />
                        <TextBlock Text="{Binding SelectionIntroduction}"
                                   Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid MinWidth="780">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="250" />
                                <ColumnDefinition Width="*" MinWidth="250" />
                                <ColumnDefinition Width="*" MinWidth="250" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Content="{Binding HistoricalInput}" ContentTemplate="{StaticResource InputCardTemplate}" />
                            <ContentControl Grid.Column="1" Content="{Binding RosterInput}" ContentTemplate="{StaticResource InputCardTemplate}" />
                            <ContentControl Grid.Column="2" Content="{Binding TemplateInput}" ContentTemplate="{StaticResource InputCardTemplate}" />
                        </Grid>
                    </ScrollViewer>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="6,10,6,0" Padding="14"
                            Background="{DynamicResource InformationSoftBrush}" VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Info24" FontSize="24" Foreground="{DynamicResource InformationBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="La revisión aparecerá después de analizar las tres entradas."
                                           FontWeight="SemiBold" />
                                <TextBlock Text="La selección y el análisis no modifican ningún documento."
                                           Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="3" Margin="6,14,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding GeneralError}" Foreground="{DynamicResource ErrorBrush}"
                                       Visibility="{Binding HasGeneralError, Converter={StaticResource BooleanVisibility}}"
                                       automation:AutomationProperties.LiveSetting="Assertive" />
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Cancelar análisis" Margin="8,0" Command="{Binding CancelCommand}"
                                Visibility="{Binding CanCancelAnalysis, Converter={StaticResource BooleanVisibility}}" />
                        <Button Grid.Column="2" Content="{Binding AnalysisActionText}"
                                Style="{StaticResource PrimaryActionButton}" Command="{Binding AnalyzeCommand}" />
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsReviewStep, Converter={StaticResource BooleanVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <ContentControl Content="{Binding HistoricalInput}" ContentTemplate="{StaticResource CompactInputCardTemplate}" />
                        <ContentControl Content="{Binding RosterInput}" ContentTemplate="{StaticResource CompactInputCardTemplate}" />
                        <ContentControl Content="{Binding TemplateInput}" ContentTemplate="{StaticResource CompactInputCardTemplate}" />
                    </UniformGrid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ClassListPanel" Margin="5">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactReviewLayout}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Clases detectadas" Style="{StaticResource SectionHeading}" />
                                    <Border Grid.Column="1" Style="{StaticResource Pill}"
                                            Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="{Binding Classes.Count}" Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <ListBox Grid.Row="1" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}"
                                         BorderThickness="0" Background="Transparent" Margin="0,12"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder" Padding="11" CornerRadius="10"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="9"
                                                        Background="{DynamicResource AccentSoftBrush}">
                                                    <ui:SymbolIcon Symbol="DocumentText20" FontSize="20"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Code}" FontSize="16" FontWeight="SemiBold" />
                                                     <TextBlock Text="{Binding StudentSummary}"
                                                               Style="{StaticResource MutedText}" FontSize="12" />
                                                </StackPanel>
                                                 <WrapPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="132">
                                                     <Button Style="{StaticResource FilterPillButton}" Padding="7,3" Margin="3"
                                                             Background="{DynamicResource InformationSoftBrush}"
                                                             BorderBrush="{DynamicResource InformationBrush}"
                                                             Command="{Binding DataContext.FilterByStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="Alumno nuevo"
                                                             ToolTip="{Binding NewStudentSummary}"
                                                             automation:AutomationProperties.Name="{Binding NewStudentSummary}"
                                                             Visibility="{Binding HasNewStudents, Converter={StaticResource BooleanVisibility}}">
                                                         <StackPanel Orientation="Horizontal">
                                                             <ui:SymbolIcon Symbol="Info16" FontSize="14" Foreground="{DynamicResource InformationBrush}" />
                                                             <TextBlock Text="{Binding NewStudentCount}" Margin="4,0,0,0"
                                                                        Foreground="{DynamicResource InformationBrush}" FontSize="11" />
                                                         </StackPanel>
                                                     </Button>
                                                     <Button Style="{StaticResource FilterPillButton}" Padding="7,3" Margin="3"
                                                             Background="{DynamicResource WarningSoftBrush}"
                                                             BorderBrush="{DynamicResource WarningBrush}"
                                                             Command="{Binding DataContext.ShowIssueGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding ConflictIssues}"
                                                             ToolTip="{Binding ConflictSummary}"
                                                             automation:AutomationProperties.Name="{Binding ConflictSummary}"
                                                             Visibility="{Binding HasConflicts, Converter={StaticResource BooleanVisibility}}">
                                                         <StackPanel Orientation="Horizontal">
                                                             <ui:SymbolIcon Symbol="Warning16" FontSize="14" Foreground="{DynamicResource WarningBrush}" />
                                                             <TextBlock Text="{Binding ConflictCount}" Margin="4,0,0,0"
                                                                        Foreground="{DynamicResource WarningBrush}" FontSize="11" />
                                                         </StackPanel>
                                                     </Button>
                                                     <Button Style="{StaticResource FilterPillButton}" Padding="7,3" Margin="3"
                                                             Background="{DynamicResource ErrorSoftBrush}"
                                                             BorderBrush="{DynamicResource ErrorBrush}"
                                                             Command="{Binding DataContext.ShowIssueGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding BlockingIssues}"
                                                             ToolTip="{Binding BlockingSummary}"
                                                             automation:AutomationProperties.Name="{Binding BlockingSummary}"
                                                             Visibility="{Binding HasBlockingIssues, Converter={StaticResource BooleanVisibility}}">
                                                         <StackPanel Orientation="Horizontal">
                                                             <ui:SymbolIcon Symbol="DismissCircle16" FontSize="14" Foreground="{DynamicResource ErrorBrush}" />
                                                             <TextBlock Text="{Binding BlockingCount}" Margin="4,0,0,0"
                                                                        Foreground="{DynamicResource ErrorBrush}" FontSize="11" />
                                                         </StackPanel>
                                                     </Button>
                                                 </WrapPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10">
                                    <TextBlock Text="{Binding BatchSummary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Margin="5">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Setter Property="Grid.Column" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactReviewLayout}" Value="True">
                                            <Setter Property="Grid.Column" Value="0" />
                                            <Setter Property="Grid.ColumnSpan" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ComboBox Grid.Row="0" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}"
                                          DisplayMemberPath="Code" Margin="0,0,0,12" MinHeight="40"
                                          automation:AutomationProperties.Name="Clase revisada">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompactReviewLayout}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>

                                 <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                                     <TextBlock Text="{Binding SelectedClass.Code, StringFormat=Alumnos de {0}}"
                                                Style="{StaticResource SectionHeading}" Margin="0,0,12,6" />
                                     <Button Style="{StaticResource FilterPillButton}" Background="{DynamicResource SuccessSoftBrush}"
                                             BorderBrush="{DynamicResource SuccessBrush}" Margin="0,0,8,6"
                                             Command="{Binding FilterByStatusCommand}" CommandParameter="Encontrado"
                                             ToolTip="Filtrar por alumnos encontrados"
                                             automation:AutomationProperties.Name="Filtrar por alumnos encontrados"
                                             Visibility="{Binding SelectedClass.HasFoundStudents, Converter={StaticResource BooleanVisibility}}">
                                         <StackPanel Orientation="Horizontal">
                                             <ui:SymbolIcon Symbol="CheckmarkCircle16" FontSize="14" Foreground="{DynamicResource SuccessBrush}" />
                                             <TextBlock Text="{Binding SelectedClass.FoundSummary}"
                                                        Foreground="{DynamicResource SuccessBrush}" FontSize="11" Margin="4,0,0,0" />
                                         </StackPanel>
                                     </Button>
                                     <Button Style="{StaticResource FilterPillButton}" Background="{DynamicResource InformationSoftBrush}"
                                             BorderBrush="{DynamicResource InformationBrush}" Margin="0,0,8,6"
                                             Command="{Binding FilterByStatusCommand}" CommandParameter="Alumno nuevo"
                                             ToolTip="Filtrar por alumnos nuevos"
                                             automation:AutomationProperties.Name="Filtrar por alumnos nuevos"
                                             Visibility="{Binding SelectedClass.HasNewStudents, Converter={StaticResource BooleanVisibility}}">
                                         <StackPanel Orientation="Horizontal">
                                             <ui:SymbolIcon Symbol="Info16" FontSize="14" Foreground="{DynamicResource InformationBrush}" />
                                             <TextBlock Text="{Binding SelectedClass.NewStudentSummary}"
                                                        Foreground="{DynamicResource InformationBrush}" FontSize="11" Margin="4,0,0,0" />
                                         </StackPanel>
                                     </Button>
                                     <Button Style="{StaticResource FilterPillButton}" Background="{DynamicResource WarningSoftBrush}"
                                             BorderBrush="{DynamicResource WarningBrush}" Margin="0,0,8,6"
                                             Command="{Binding FilterByStatusCommand}" CommandParameter="Conflicto"
                                             ToolTip="Filtrar por alumnos omitidos debido a nombres duplicados"
                                             automation:AutomationProperties.Name="Filtrar por alumnos en conflicto"
                                             Visibility="{Binding SelectedClass.HasConflicts, Converter={StaticResource BooleanVisibility}}">
                                         <StackPanel Orientation="Horizontal">
                                             <ui:SymbolIcon Symbol="Warning16" FontSize="14" Foreground="{DynamicResource WarningBrush}" />
                                             <TextBlock Text="{Binding SelectedClass.ConflictSummary}"
                                                        Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="4,0,0,0" />
                                         </StackPanel>
                                     </Button>
                                     <Button Style="{StaticResource FilterPillButton}" Margin="0,0,8,6"
                                             Background="{DynamicResource ErrorSoftBrush}"
                                             BorderBrush="{DynamicResource ErrorBrush}"
                                             Command="{Binding ShowIssueGroupCommand}" CommandParameter="{Binding SelectedClass.BlockingIssues}"
                                             ToolTip="{Binding SelectedClass.BlockingSummary}"
                                             automation:AutomationProperties.Name="{Binding SelectedClass.BlockingSummary}"
                                             Visibility="{Binding SelectedClass.HasBlockingIssues, Converter={StaticResource BooleanVisibility}}">
                                         <StackPanel Orientation="Horizontal">
                                             <ui:SymbolIcon Symbol="DismissCircle16" FontSize="14" Foreground="{DynamicResource ErrorBrush}" />
                                             <TextBlock Text="{Binding SelectedClass.BlockingSummary}"
                                                        Foreground="{DynamicResource ErrorBrush}" FontSize="11" Margin="4,0,0,0" />
                                         </StackPanel>
                                     </Button>
                                     <Button Style="{StaticResource FilterPillButton}" Margin="0,0,8,6"
                                             Command="{Binding ShowIssueGroupCommand}" CommandParameter="{Binding SelectedClass.AllIssues}"
                                             ToolTip="Abrir las incidencias de la clase"
                                             automation:AutomationProperties.Name="Abrir las incidencias de la clase"
                                             Visibility="{Binding SelectedClass.HasIssues, Converter={StaticResource BooleanVisibility}}">
                                         <StackPanel Orientation="Horizontal">
                                             <ui:SymbolIcon Symbol="Open16" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
                                             <TextBlock Text="Ver incidencias" Foreground="{DynamicResource AccentBrush}"
                                                        FontSize="11" Margin="4,0,0,0" />
                                         </StackPanel>
                                     </Button>
                                 </WrapPanel>

                                 <Grid Grid.Row="2" Margin="0,8,0,12">
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*" />
                                         <ColumnDefinition Width="220" />
                                         <ColumnDefinition Width="Auto" />
                                     </Grid.ColumnDefinitions>
                                    <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="Buscar alumno o NIA…"
                                                automation:AutomationProperties.Name="Buscar alumno o NIA" />
                                     <ComboBox Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding StatusFilters}"
                                               SelectedItem="{Binding SelectedFilter}"
                                               automation:AutomationProperties.Name="Filtrar por estado" />
                                     <Button Grid.Column="2" Margin="8,0,0,0" Content="Limpiar filtros"
                                             Command="{Binding ClearReviewFiltersCommand}"
                                             Visibility="{Binding HasActiveReviewFilters, Converter={StaticResource BooleanVisibility}}" />
                                 </Grid>

                                <Border x:Name="ReviewTableBorder" Grid.Row="3"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10"
                                        SizeChanged="ReviewTableBorder_SizeChanged">
                                  <Grid x:Name="ReviewTableSurface" Background="{DynamicResource SurfaceBrush}">
                                    <Border Height="{Binding ColumnHeaderHeight, ElementName=ReviewGrid}"
                                            VerticalAlignment="Top" IsHitTestVisible="False"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource TableSeparatorBrush}"
                                            BorderThickness="0,0,0,1" />
                                    <DataGrid x:Name="ReviewGrid" ItemsSource="{Binding VisibleStudents}" AutoGenerateColumns="False"
                                               MinWidth="0" HorizontalAlignment="Stretch" Background="Transparent"
                                               EnableColumnVirtualization="True"
                                               VirtualizingPanel.IsVirtualizing="True"
                                               VirtualizingPanel.VirtualizationMode="Recycling"
                                               PreviewMouseLeftButtonDown="ReviewGrid_PreviewMouseLeftButtonDown"
                                               PreviewMouseMove="ReviewGrid_PreviewMouseMove"
                                               PreviewMouseLeftButtonUp="ReviewGrid_PreviewMouseLeftButtonUp"
                                               PreviewKeyDown="ReviewGrid_PreviewKeyDown">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Ordinal}" Width="52"
                                                                HeaderStyle="{StaticResource CenteredDataGridHeader}"
                                                                ElementStyle="{StaticResource OrdinalDataGridTextElement}" />
                                            <DataGridTextColumn Header="Nombre y apellidos" Binding="{Binding Name}" Width="2.15*" MinWidth="220"
                                                                ElementStyle="{StaticResource NameDataGridTextElement}" />
                                            <DataGridTextColumn Header="NIA" Binding="{Binding StudentNumber}" Width="110"
                                                                ElementStyle="{StaticResource DataGridTextElement}" />
                                            <DataGridTemplateColumn Header="Estado" Width="1.65*" MinWidth="180">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="StatusBadge" HorizontalAlignment="Left"
                                                                Style="{StaticResource Pill}"
                                                                ToolTip="{Binding Status}"
                                                                Background="{DynamicResource SuccessSoftBrush}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon x:Name="StatusIcon" Symbol="CheckmarkCircle16" FontSize="14"
                                                                               Foreground="{DynamicResource SuccessBrush}" />
                                                                 <TextBlock x:Name="StatusText" Text="{Binding Status}" Margin="4,0,0,0"
                                                                            Foreground="{DynamicResource SuccessBrush}" FontSize="12"
                                                                            MaxWidth="140" TextTrimming="CharacterEllipsis"
                                                                            TextWrapping="NoWrap" />
                                                            </StackPanel>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding ResolutionType}" Value="{x:Static domain:HistoricalResolutionType.NewStudent}">
                                                                <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource InformationSoftBrush}" />
                                                                <Setter TargetName="StatusIcon" Property="ui:SymbolIcon.Symbol" Value="Info16" />
                                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource InformationBrush}" />
                                                                <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource InformationBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ResolutionType}" Value="{x:Static domain:HistoricalResolutionType.Conflict}">
                                                                <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                                <Setter TargetName="StatusIcon" Property="ui:SymbolIcon.Symbol" Value="Warning16" />
                                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Procedencia" Width="1.2*" MinWidth="140">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Source}" Style="{StaticResource DataGridTextElement}"
                                                                   ToolTip="{Binding Source}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Detalle" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource InlineDetailButton}"
                                                                ToolTip="Abrir el detalle de este alumno"
                                                                automation:AutomationProperties.Name="Abrir detalle del alumno"
                                                                Command="{Binding DataContext.ShowStudentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="Ver detalle" TextWrapping="NoWrap"
                                                                       Foreground="{DynamicResource AccentBrush}" />
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="18"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasVisibleStudents}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="SearchInfo24" FontSize="28"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock Text="No hay alumnos que coincidan con los filtros."
                                                       FontWeight="SemiBold" Margin="0,8,0,0" />
                                            <TextBlock Text="Cambia la búsqueda o selecciona otro estado."
                                                       Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                  </Grid>
                                </Border>
                                <Grid Grid.Row="4" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding VisibleStudentSummary}" Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding ActiveFilterSummary, StringFormat= · {0}}" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Visibility="{Binding HasActiveReviewFilters, Converter={StaticResource BooleanVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Haz clic en una fila o pulsa Enter para ver el detalle"
                                               Margin="12,0,0,0" Style="{StaticResource MutedText}"
                                               FontSize="12" TextWrapping="NoWrap" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="5,12,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Volver a archivos" Command="{Binding BackToFilesCommand}" />
                        <TextBlock Grid.Column="1" Text="{Binding ReviewReadinessMessage}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   MaxWidth="240" Margin="12,0" TextAlignment="Right"
                                   Style="{StaticResource MutedText}" FontSize="12" />
                        <Button Grid.Column="2" Content="Ver todas las incidencias" Margin="8,0"
                                Command="{Binding ShowAllIssuesCommand}" />
                        <Button Grid.Column="3" Content="Configurar documentos" Style="{StaticResource PrimaryActionButton}"
                                ToolTip="Continuar para configurar las cabeceras y la ubicación de salida"
                                automation:AutomationProperties.HelpText="No genera archivos; abre la configuración de salida"
                                Command="{Binding ContinueToGenerationCommand}" />
                    </Grid>
                </Grid>

                <Grid x:Name="GenerationStep" Visibility="{Binding IsGenerationStep, Converter={StaticResource BooleanVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsConfigurationVisible, Converter={StaticResource BooleanVisibility}}">
                        <StackPanel>
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <UniformGrid.Style>
                                    <Style TargetType="UniformGrid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompactReviewLayout}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UniformGrid.Style>
                                <ContentControl Content="{Binding HistoricalInput}" ContentTemplate="{StaticResource CompactInputCardTemplate}" />
                                <ContentControl Content="{Binding RosterInput}" ContentTemplate="{StaticResource CompactInputCardTemplate}" />
                                <ContentControl Content="{Binding TemplateInput}" ContentTemplate="{StaticResource CompactInputCardTemplate}" />
                            </UniformGrid>
                            <StackPanel Margin="0,0,0,10">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompactReviewLayout}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ContentControl Content="{Binding HistoricalInput}" ContentTemplate="{StaticResource CompactInputCardTemplate}" />
                                <ContentControl Content="{Binding RosterInput}" ContentTemplate="{StaticResource CompactInputCardTemplate}" />
                                <ContentControl Content="{Binding TemplateInput}" ContentTemplate="{StaticResource CompactInputCardTemplate}" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Margin="5" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Cabecera de los documentos" Style="{StaticResource Heading}" />
                                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <Button Content="Cambiar plantilla" Margin="5,0"
                                                        Command="{Binding BrowseInputCommand}"
                                                        CommandParameter="{Binding TemplateInput}" />
                                                <Button Content="Restaurar incluida" Margin="5,0"
                                                        Command="{Binding RestoreIncludedTemplateCommand}"
                                                        Visibility="{Binding TemplateInput.CanRestoreBundled, Converter={StaticResource BooleanVisibility}}" />
                                            </WrapPanel>
                                        </Grid>
                                        <TextBlock Text="Personaliza el nombre visible de cada clase y el tutor o tutora que aparecerá en el documento."
                                                   Style="{StaticResource MutedText}" Margin="0,3,0,12" />
                                        <TextBlock Text="{Binding HeaderCustomizationMessage}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12" />

                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompactReviewLayout}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Clase detectada" FontWeight="SemiBold" Margin="10,8" />
                                                <TextBlock Grid.Column="1" Text="Nombre visible de la clase" FontWeight="SemiBold" Margin="10,8" />
                                                <TextBlock Grid.Column="2" Text="Tutor/a (opcional)" FontWeight="SemiBold" Margin="10,8" />
                                            </Grid>
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding ClassHeaders}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="140" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding DetectedClass}" Margin="10,8" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Margin="7,2">
                                                                <TextBox IsEnabled="{Binding IsEditable}"
                                                                         Text="{Binding DisplayTitle, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                                                <TextBlock Text="{Binding TitleError}" Foreground="{DynamicResource ErrorBrush}"
                                                                           FontSize="10" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Margin="7,2">
                                                                <TextBox IsEnabled="{Binding IsEditable}"
                                                                         Text="{Binding TutorName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                                                <TextBlock Text="{Binding TutorError}" Foreground="{DynamicResource ErrorBrush}"
                                                                           FontSize="10" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding ClassHeaders}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompactReviewLayout}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DetectedClass}" FontWeight="SemiBold" />
                                                            <TextBlock Text="Nombre visible de la clase" Margin="0,8,0,4" />
                                                            <TextBox IsEnabled="{Binding IsEditable}"
                                                                     Text="{Binding DisplayTitle, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                                            <TextBlock Text="{Binding TitleError}" Foreground="{DynamicResource ErrorBrush}"
                                                                       FontSize="10" TextWrapping="Wrap" />
                                                            <TextBlock Text="Tutor/a (opcional)" Margin="0,8,0,4" />
                                                            <TextBox IsEnabled="{Binding IsEditable}"
                                                                     Text="{Binding TutorName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                                            <TextBlock Text="{Binding TutorError}" Foreground="{DynamicResource ErrorBrush}"
                                                                       FontSize="10" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Margin="5">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompactReviewLayout}" Value="True">
                                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Ubicación de los documentos" Style="{StaticResource SectionHeading}" />
                                        <TextBlock Text="Guardar dentro de" Margin="0,10,0,4" />
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding OutputParent, Mode=OneWay}" IsReadOnly="True" />
                                            <Button Grid.Column="1" Content="Elegir carpeta…" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}" />
                                        </Grid>
                                        <TextBlock Text="Nombre de la nueva carpeta" Margin="0,10,0,4" />
                                        <TextBox Text="{Binding OutputFolderName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Ubicación final" Margin="0,10,0,2" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding OutputDirectory}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        <TextBlock Text="Se creará una carpeta nueva. No se sobrescribirán documentos existentes."
                                                   Margin="0,7,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding OutputError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Margin="5">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompactReviewLayout}" Value="True">
                                                    <Setter Property="Grid.Row" Value="1" />
                                                    <Setter Property="Grid.Column" Value="0" />
                                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Resumen de generación" Style="{StaticResource SectionHeading}" />
                                        <TextBlock Text="{Binding BatchSummary}" Margin="0,10,0,0" FontWeight="SemiBold" />
                                        <TextBlock Text="Los avisos no bloqueantes se conservarán; los filtros no modifican el lote."
                                                   Margin="0,7,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ProgressText}" Margin="0,12,0,0" />
                                        <TextBlock Text="{Binding FinalStatus}" Margin="0,8,0,0" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="0" Margin="5" Style="{StaticResource Card}"
                            Visibility="{Binding IsGenerationOperationVisible, Converter={StaticResource BooleanVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                            <ProgressBar IsIndeterminate="True" Height="4" MinWidth="360" Margin="0,0,0,20" />
                            <TextBlock Text="{Binding OperationActionText}" Style="{StaticResource Heading}"
                                       HorizontalAlignment="Center"
                                       automation:AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding ProgressText}" Margin="0,8,0,0" TextAlignment="Center"
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            <TextBlock Text="Talos terminará la operación o su limpieza antes de permitir otra acción."
                                       Margin="0,12,0,0" TextAlignment="Center" Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Margin="5" Style="{StaticResource Card}"
                            Visibility="{Binding IsGenerationCompleted, Converter={StaticResource BooleanVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="44"
                                               Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="ResultHeading" Text="Documentos generados correctamente"
                                           Style="{StaticResource Heading}" Focusable="True"
                                           FontSize="24" Margin="0,14,0,0" TextAlignment="Center"
                                           automation:AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{Binding GenerationResult.Summary}" Margin="0,8,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                                <Border Margin="0,18,0,0" Padding="14" Background="{DynamicResource SurfaceAltBrush}"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="Guardados en" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding GenerationResult.OutputDirectory}" Margin="0,5,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding OutputOpenError}" Foreground="{DynamicResource ErrorBrush}"
                                                   Margin="0,7,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,12,0,0" Padding="12" Background="{DynamicResource WarningSoftBrush}"
                                        CornerRadius="8"
                                        Visibility="{Binding HasResultIssues, Converter={StaticResource BooleanVisibility}}">
                                    <TextBlock Text="La generación contiene avisos que puedes consultar. Los alumnos sin información histórica, con coincidencias ambiguas o con históricos contradictorios se incluyen con el nombre del listado y los demás campos vacíos."
                                               TextWrapping="Wrap" />
                                </Border>
                                <Expander Header="Resumen de los documentos" Margin="0,12,0,0">
                                    <StackPanel Margin="12,8,0,0">
                                        <TextBlock Text="{Binding GenerationResult.TemplateName, StringFormat=Plantilla: {0}}" />
                                        <TextBlock Text="{Binding GenerationResult.HeaderSummary}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="1" Margin="6,12,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Volver a revisión" Command="{Binding BackToReviewCommand}"
                                Visibility="{Binding IsConfigurationVisible, Converter={StaticResource BooleanVisibility}}" />
                        <Button Grid.Column="2" Content="Cancelar generación" Margin="8,0" Command="{Binding CancelCommand}"
                                Visibility="{Binding CanCancelGeneration, Converter={StaticResource BooleanVisibility}}" />
                        <Button Grid.Column="3" Content="Generar documentos" Style="{StaticResource PrimaryActionButton}"
                                Command="{Binding GenerateCommand}"
                                Visibility="{Binding IsConfigurationVisible, Converter={StaticResource BooleanVisibility}}" />
                        <Button Grid.Column="3" Content="{Binding OperationActionText}" IsEnabled="False"
                                Style="{StaticResource PrimaryActionButton}"
                                Visibility="{Binding IsGenerationOperationVisible, Converter={StaticResource BooleanVisibility}}" />
                        <Grid Grid.Column="0" Grid.ColumnSpan="4"
                              Visibility="{Binding IsGenerationCompleted, Converter={StaticResource BooleanVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Nueva generación" Command="{Binding NewGenerationCommand}" />
                            <Button Grid.Column="2" Content="Ver todas las incidencias" Margin="8,0"
                                    Command="{Binding ShowAllIssuesCommand}"
                                    Visibility="{Binding HasResultIssues, Converter={StaticResource BooleanVisibility}}" />
                            <Button Grid.Column="3" Content="Abrir carpeta de salida"
                                    Style="{StaticResource PrimaryActionButton}" Command="{Binding OpenOutputCommand}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
